MONGODB_URI=
MONGODB_DB=
MEDIUM_RSS=
SPOTIFY_REFRESH_TOKEN=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
GITHUB_API_GRAPHQL_ENDPOINT=
GITHUB_API_GRAPHQL_TOKEN=

# Crawler logging (middleware.ts -> /api/bot-hit -> the bot_hits collection).
# Without BOT_LOG_SECRET nothing is written to MongoDB; crawler hits still show
# up as "[bot] ..." lines in the runtime logs. Any long random string works.
BOT_LOG_SECRET=
# Guards GET /api/bot-stats?token=... , which aggregates the collection above.
BOT_STATS_TOKEN=
